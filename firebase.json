{
  "hosting": {
    "public": "web",
    "ignore": ["**/.*"],
    "redirects": [
      { "source": "/qr", "destination": "/", "type": 302 }
    ],
    "headers": [
      { "source": "**/*.@(jpg|png|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**/*.@(html|js|css|glb)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
