{
  "hosting": {
    "public": "web",
    "ignore": ["**/.*"],
    "headers": [
      { "source": "**/*.@(jpg|png|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**/*.@(html|js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
